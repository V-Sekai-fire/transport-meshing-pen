; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="meshing-pen"
run/main_scene="res://xr_main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

VSKVersion="*res://addons/vsk_version/vsk_version.gd"

[display]

; Exclusive fullscreen that cannot be resized or maximized (mode 3 with resizable=false drops to windowed
; on Windows).
window/size/mode=4
window/size/resizable=false
window/size/maximize_disabled=true
window/vsync/vsync_mode=0
; Under Movie Maker (the "movie" feature) the recording is 1920x1080 in a window.
window/size/viewport_width.movie=1920
window/size/viewport_height.movie=1080
window/size/mode.movie=0

[editor_plugins]

enabled=PackedStringArray("res://addons/GPUTrail-main/plugin.cfg", "res://addons/vsk_version/plugin.cfg", "res://addons/godot_sandbox/plugin.cfg")

[gui]

theme/custom_font="res://fonts/Inter-Regular.ttf"
theme/default_font_multichannel_signed_distance_field=true

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/screen_space_roughness_limiter/enabled=false
anti_aliasing/quality/use_debanding=true
mesh_lod/lod_change/threshold_pixels=0.2

[sandbox]

; As interactor-dress-on's project.godot: no Docker toolchain on a guest fault.
; Native translation is turned on per process by stages/sandbox_util.gd where
; bintr/ holds a library for this platform (tools/build.exs makes them).
toolchain/docker_enabled=false
binary_translation/enabled=false

[xr]

openxr/enabled=true
shaders/enabled=true

[input]

move_forwards={
"deadzone": 0.2,
"events": []
}
move_backwards={
"deadzone": 0.2,
"events": []
}
move_left={
"deadzone": 0.2,
"events": []
}
move_right={
"deadzone": 0.2,
"events": []
}
rotate_camera_left={
"deadzone": 0.2,
"events": []
}
rotate_camera_right={
"deadzone": 0.2,
"events": []
}
