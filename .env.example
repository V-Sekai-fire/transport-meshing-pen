# Copy to .env (untracked) and edit; tools/build.exs reads it, the environment wins.
# The double editor from ENGINE_TAG; Godot on PATH (Homebrew's 4.7) re-imports and strips keys.
GODOT=/path/to/godot.macos.editor.double.arm64
# The native-translation compiler; Apple clang on macOS.
BINTR_CC=/usr/bin/clang
# Prepended to PATH, colon-separated.
PATH_PREPEND=/opt/homebrew/opt/llvm/bin
# The OpenXR runtime: OXRSys from interactor-xr-pilot's build. Without one, Godot blocks at start.
XR_RUNTIME_JSON=/path/to/interactor-xr-pilot/build/oxrsys/runtime/oxrsys-runtime.json
# datasource-cassie's raw_data, for the cassie and events gates outside a workspace checkout.
CASSIE_RAW_DATA=/path/to/datasource-cassie/data/raw_data
# What a bare `elixir tools/build.exs` runs: here, the committed ELFs translated and gated.
BUILD_ARGS=--no-elfs --no-host --gates=bintr
