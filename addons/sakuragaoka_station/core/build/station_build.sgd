# The station build's pure compute as plain GDScript, compiled ahead of time per real_t by
# 4-entities/godot-sandbox-gdscript-compiler:
#   gdscript_to_riscv --double-precision -o addons/sakuragaoka_station/core/build/station_build.double.elf addons/sakuragaoka_station/core/build/station_build.sgd
# Each function ports one the host keeps (core/build/build_kernels.gd picks; tools/build_check.gd compares):
#   terrain_grid   environment/terrain.gd build_patch's heights and normals (common.gd terrain_h)
extends Node


func _to_i32(x: int) -> int:
	x &= 0xFFFFFFFF
	return x - 0x100000000 if x >= 0x80000000 else x


func _imul(a: int, b: int) -> int:
	var bu := b & 0xFFFFFFFF
	var lo := (a & 0xFFFF) * bu
	var hi := (((a >> 16) & 0xFFFF) * bu) & 0xFFFF
	return _to_i32(lo + (hi << 16))


func _sstep(a: float, b: float, x: float) -> float:
	var t := clampf((x - a) / (b - a), 0.0, 1.0)
	return t * t * (3.0 - 2.0 * t)


func _hash2(ix: int, iz: int, seed: int) -> float:
	var h := _to_i32(_imul(_to_i32(ix), 374761393) + _imul(_to_i32(iz), 668265263) + _imul(_to_i32(seed), 1442695041))
	h = _imul(h ^ ((h & 0xFFFFFFFF) >> 13), 1274126177)
	h = _to_i32(h ^ ((h & 0xFFFFFFFF) >> 16))
	return float(h & 0xFFFFFFFF) / 4294967296.0


func _vnoise(x: float, z: float, seed: int) -> float:
	var ix := floori(x)
	var iz := floori(z)
	var fx := x - ix
	var fz := z - iz
	var ux := fx * fx * (3.0 - 2.0 * fx)
	var uz := fz * fz * (3.0 - 2.0 * fz)
	var a := _hash2(ix, iz, seed)
	var b := _hash2(ix + 1, iz, seed)
	var c := _hash2(ix, iz + 1, seed)
	var d := _hash2(ix + 1, iz + 1, seed)
	return a + (b - a) * ux + (c - a) * uz + (a - b - c + d) * ux * uz


func _fbm(x: float, z: float, oct: int, seed: int) -> float:
	var s := 0.0
	var a := 0.5
	var n := 0.0
	var f := 1.0
	for i in oct:
		s += a * _vnoise(x * f + i * 17.3, z * f - i * 9.1, seed + i * 7)
		n += a
		a *= 0.5
		f *= 2.03
	return s / n


func _ridged(x: float, z: float, oct: int, seed: int) -> float:
	var s := 0.0
	var a := 0.5
	var n := 0.0
	var f := 1.0
	for i in oct:
		var v := 1.0 - absf(_vnoise(x * f + i * 5.7, z * f + i * 3.1, seed + i * 11) * 2.0 - 1.0)
		s += a * v * v
		n += a
		a *= 0.5
		f *= 2.1
	return s / n


func _rect_influence(x: float, z: float, x0: float, x1: float, z0: float, z1: float, r: float) -> float:
	var dx := maxf(maxf(x0 - x, 0.0), x - x1)
	var dz := maxf(maxf(z0 - z, 0.0), z - z1)
	return 1.0 - _sstep(0.0, r, sqrt(dx * dx + dz * dz))


func _hill_mask(x: float, z: float) -> float:
	var m := 1.0
	m *= 1.0 - _rect_influence(x, z, -117.0, 117.0, -122.0, 153.0, 70.0)
	if m <= 0.0:
		return 0.0
	m *= 1.0 - _rect_influence(x, z, -275.0, 275.0, -101.0, 215.0, 70.0)
	if m <= 0.0:
		return 0.0
	m *= 1.0 - _rect_influence(x, z, -110.0, 110.0, 116.0, 255.0, 70.0)
	if m <= 0.0:
		return 0.0
	m *= 1.0 - _rect_influence(x, z, -445.0, 445.0, -62.0, -24.0, 55.0)
	if m <= 0.0:
		return 0.0
	m *= 1.0 - _rect_influence(x, z, -5000.0, 5000.0, -282.0, -82.0, 70.0)
	if m <= 0.0:
		return 0.0
	return m


func _bump(v: float, c: float, w: float) -> float:
	var t := 1.0 - clampf(absf(v - c) / w, 0.0, 1.0)
	return t * t * (3.0 - 2.0 * t)


func _hill_relief(x: float, z: float) -> float:
	if z < -181.0:
		var zz := z + (_fbm(x / 260.0, 3.3, 3, 11) - 0.5) * 90.0
		var r1 := _bump(zz, -372.0, 88.0) * (17.0 + 26.0 * _fbm(x / 120.0, 1.7, 3, 12))
		var r2 := _bump(zz, -575.0, 150.0) * (38.0 + 36.0 * _ridged(x / 210.0, 4.1, 3, 13))
		var plain := _sstep(-282.0, -430.0, zz) * 7.0 + _sstep(-470.0, -700.0, zz) * 16.0
		var small := (_fbm(x / 45.0, z / 45.0, 3, 14) - 0.5) * 7.0 * _sstep(-282.0, -330.0, z)
		return maxf(r1, r2 * 0.25) + r2 * 0.8 + plain + small
	var q := (z - 30.0) / 1.08
	var re := sqrt(x * x + q * q)
	var g := _sstep(250.0, 560.0, re)
	var n := _fbm(x / 170.0, z / 170.0, 4, 21)
	var n2 := _fbm(x / 60.0, z / 60.0, 3, 22)
	return g * (14.0 + 42.0 * n * n + 9.0 * n2) + _sstep(520.0, 720.0, re) * 22.0 * _fbm(x / 300.0, z / 300.0, 2, 23)


# layout.gd height_at, with RAIL.groundY -0.30, RAIL.railTopY 0.15, CROSSING.x -12, roadHalfW 2.75.
func _height_at(x: float, z: float) -> float:
	var h := 0.0
	if z <= 0.0:
		h = 0.0
	elif z < 10.0:
		h = 0.028 * z * z / 20.0
	else:
		h = 0.028 * (z - 5.0)
	if z < -33.0 and z > -53.0:
		var inner := _sstep(-33.0, -34.0, z) * _sstep(-53.0, -52.0, z)
		var hc := lerpf(0.0, -0.30, inner)
		var dx := absf(x - -12.0)
		if dx < 2.75 + 1.5:
			var wx := 1.0 - _sstep(2.75, 2.75 + 1.5, dx)
			var along := _sstep(-35.4, -38.4, z) * _sstep(-50.6, -47.6, z)
			hc = lerpf(hc, lerpf(0.0, 0.15, along), wx)
		h = hc
	if z < -84.0:
		if z >= -91.5:
			h = 3.2 * _sstep(-84.0, -91.5, z)
		elif z >= -94.5:
			h = 3.2
		elif z >= -99.0:
			h = lerpf(3.2, 0.2, _sstep(-94.5, -99.0, z))
		elif z >= -101.0:
			h = lerpf(0.2, -1.2, _sstep(-99.0, -101.0, z))
		elif z >= -116.0:
			h = -1.2
		elif z >= -119.0:
			h = lerpf(-1.2, 0.6, _sstep(-116.0, -119.0, z))
		else:
			h = 0.6 + 0.02 * (-119.0 - z)
	return h


# common.gd BRIDGE: x -160, deckY 3.45.
func _bridge_embankment(x: float, z: float) -> float:
	if z > -118.6 or z < -182.0:
		return 0.0
	var top := lerpf(3.45, _height_at(-160.0, -175.0), _sstep(-120.0, -175.0, z))
	var side := maxf(0.0, absf(x - -160.0) - 4.5)
	var h_top := top - side * 0.55
	var base := _height_at(x, z)
	return maxf(0.0, h_top - base) * _sstep(-118.6, -120.2, z)


# common.gd PARK.mound: x 78.5, z -20.5, rx 11.5, rz 8.6, h 2.35.
func _park_mound(x: float, z: float) -> float:
	var dx := (x - 78.5) / 11.5
	var dz := (z - -20.5) / 8.6
	var d := sqrt(dx * dx + dz * dz)
	if d >= 1.0:
		return 0.0
	var f := 0.5 * (1.0 + cos(PI * d))
	var lx := (x - 78.5 - 5.0) / 5.0
	var lz := (z - -20.5 - 3.0) / 4.0
	var lobe := 0.18 * maxf(0.0, 1.0 - sqrt(lx * lx + lz * lz))
	return 2.35 * f * (1.0 + lobe)


func terrain_h(x: float, z: float) -> float:
	var h := _height_at(x, z)
	var m := _hill_mask(x, z)
	if m > 0.0:
		h += m * _hill_relief(x, z)
	if x > -200.0 and x < -120.0:
		h += _bridge_embankment(x, z)
	if x > 66.0 and x < 91.0 and z > -30.0 and z < -11.0:
		h += _park_mound(x, z)
	return h


# [H, NR] for the grid xs x zs, row j along z, as build_patch fills them (float32, 3 normals per vertex).
func terrain_grid(xs: PackedFloat64Array, zs: PackedFloat64Array) -> Array:
	var nx := xs.size()
	var nz := zs.size()
	var H := PackedFloat32Array()
	H.resize(nx * nz)
	var NR := PackedFloat32Array()
	NR.resize(nx * nz * 3)
	for j in nz:
		var z := zs[j]
		for i in nx:
			var x := xs[i]
			var k := j * nx + i
			var e := 2.5
			if absf(x) <= 300.0 and z > -300.0 and z < 300.0:
				e = 0.5
			var hx := terrain_h(x + e, z) - terrain_h(x - e, z)
			var hz := terrain_h(x, z + e) - terrain_h(x, z - e)
			var nl := sqrt(hx * hx + 4.0 * e * e + hz * hz)
			H[k] = terrain_h(x, z)
			NR[k * 3] = -hx / nl
			NR[k * 3 + 1] = 2.0 * e / nl
			NR[k * 3 + 2] = -hz / nl
	return [H, NR]

